# ---- 构建产物与本地环境 ----
build/
out/
.gradle/
run/
runs/
logs/
*.log
*.iml
.idea/
.vscode/
*.hprof
classpath/
bin/
tmp/

# ---- 第三方模组 jar：不能分发 ----
# libs/ 里的 SlashBlade 与 SJAP 的 jar 是别人的作品（拔刀剑的美术资源是"保留所有权利"），
# 我们只把它们当编译期依赖用，绝不能提交到仓库里。
libs/**/*.jar
libs/**/*.zip

# ---- 第三方原始模型：同样不能分发 ----
# 散华的 .obj / 原贴图来自 SlashBlade 本体，虽然已获制作团队授权用于本模组，
# 但那是"能在游戏里引用"的授权，不等于可以把文件放进公开仓库。
_材质/**/*.obj
_材质/**/*.mtl

# ---- 素材中间产物 ----
# _材质 里保留脚本（它们是生成贴图的过程），图片本身是运行时能重新生成的，且体积大。
_材质/**/*.png
_材质/**/*.jpg
_材质/**/*.pyc
_材质/**/__pycache__/

# ---- 私人内容 ----
# 授权截图是 QQ 聊天记录，含昵称与头像，不放进公开仓库。
docs/授权-*.png
docs/授权-*.jpg

# ---- 发布用截图 ----
# 游戏里截的图只上传到 CurseForge / MC百科 的页面，不进仓库：
# 体积大，而且其中几张带存档地形与玩家信息。
docs/release/shots/
docs/release/screenshot.png
docs/release/icon_from_shot_*.png

# ---- 系统垃圾 ----
Thumbs.db
desktop.ini
.DS_Store
